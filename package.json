{
  "name": "degems-ecommerce-application",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:storefront",
    "dev:api": "npm run dev --workspace=@degems/api",
    "dev:admin": "npm run dev --workspace=@degems/admin",
    "dev:storefront": "npm run dev --workspace=@degems/storefront",
    "build": "npm run build:api && npm run build:admin && npm run build:storefront",
    "build:api": "npm run build --workspace=@degems/api",
    "build:admin": "npm run build --workspace=@degems/admin",
    "build:storefront": "npm run build --workspace=@degems/storefront",
    "start": "npm run start:storefront",
    "start:api": "npm run start --workspace=@degems/api",
    "start:admin": "npm run start --workspace=@degems/admin",
    "start:storefront": "npm run start --workspace=@degems/storefront",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:api && npm run typecheck:admin && npm run typecheck:storefront",
    "typecheck:api": "npm run typecheck --workspace=@degems/api",
    "typecheck:admin": "npm run typecheck --workspace=@degems/admin",
    "typecheck:storefront": "npm run typecheck --workspace=@degems/storefront",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test-integration.mjs",
    "backup:db": "bash scripts/backup-database.sh",
    "restore:db-check": "bash scripts/restore-database.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.2",
    "@aws-sdk/client-s3": "^3.840.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "nodemailer-v10": "npm:nodemailer@^10.5.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
